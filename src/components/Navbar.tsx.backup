import { Search, Plus, User, LogOut } from 'lucide-react';
import { Link, useNavigate } from 'react-router-dom';
import { useState } from 'react';
import { useAuth } from '../hooks/useAuth';
import { motion, AnimatePresence } from 'framer-motion';

interface NavbarProps {
  onAddListing?: () => void;
}

const Navbar = ({ onAddListing }: NavbarProps) => {
  const { currentUser, logout } = useAuth();
  const navigate = useNavigate();
  const [showDropdown, setShowDropdown] = useState(false);
  const [searchValue, setSearchValue] = useState('');

  const handleLogout = async () => {
    try {
      await logout();
      navigate('/auth');
    } catch (error) {
      console.error('Logout error:', error);
    }
  };

  return (
    <nav className="sticky top-0 z-40 border-b border-white/10 bg-gradient-to-b from-slate-950/90 via-slate-950/85 to-slate-950/80 backdrop-blur-2xl">
      {/* Subtle top border glow */}
      <div className="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sky-500/30 to-transparent" />
      
      <div className="mx-auto max-w-7xl px-4 sm:px-6">
        <div className="flex h-24 items-center justify-between gap-4 py-3">
          <motion.div 
            className="flex items-center gap-3"
            initial={{ opacity: 0, x: -10 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.5 }}
          >
            <Link to="/dashboard" className="text-2xl font-bold tracking-tight text-white transition-colors hover:text-sky-300 duration-300">
              DSwap
            </Link>
          </motion.div>

          <motion.div 
            className="hidden flex-1 max-w-2xl md:block"
            initial={{ opacity: 0, y: -10 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.5, delay: 0.1 }}
          >
            <div className="group relative">
              <Search className="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500 transition-colors duration-300 group-focus-within:text-sky-400" />
              <input
                type="text"
                placeholder="Search listings..."
                value={searchValue}
                onChange={(event) => setSearchValue(event.target.value)}
                className="w-full rounded-2xl border border-white/15 bg-slate-900/60 backdrop-blur-sm py-3 pl-11 pr-4 text-sm text-slate-100 outline-none transition duration-300 placeholder:text-slate-600 focus:border-sky-400/50 focus:bg-slate-900/80 focus:ring-2 focus:ring-sky-500/25 hover:border-white/20"
              />
              {/* Inner shadow effect */}
              <div className="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-b from-white/5 to-transparent opacity-0 transition-opacity duration-300 group-focus-within:opacity-100" />
            </div>
          </motion.div>

          <motion.div 
            className="flex items-center space-x-3"
            initial={{ opacity: 0, x: 10 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.5, delay: 0.2 }}
          >
            <motion.button
              onClick={onAddListing}
              whileHover={{ scale: 1.05, y: -2 }}
              whileTap={{ scale: 0.97 }}
              className="group relative flex items-center space-x-2 rounded-2xl bg-gradient-to-r from-cyan-500 via-sky-500 to-indigo-500 px-4 py-2.5 text-sm font-semibold text-white shadow-[0_18px_60px_rgba(59,130,246,0.24)] transition duration-300 hover:shadow-[0_24px_80px_rgba(59,130,246,0.4)] overflow-hidden"
            >
              {/* Premium glow bloom effect */}
              <div className="absolute inset-0 rounded-2xl bg-gradient-to-r from-cyan-400/0 via-sky-400/20 to-indigo-400/0 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
              <Plus className="h-4 w-4 relative" />
              <span className="hidden sm:inline relative">Add Listing</span>
            </motion.button>

            <div className="relative">
              <motion.button
                onClick={() => setShowDropdown(!showDropdown)}
                whileTap={{ scale: 0.95 }}
                whileHover={{ scale: 1.05 }}
                className="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/5 text-slate-100 transition duration-300 hover:bg-white/15 hover:border-sky-400/50 shadow-[0_8px_24px_rgba(59,130,246,0.1)] hover:shadow-[0_12px_32px_rgba(59,130,246,0.15)]"
              >
                <User className="h-4 w-4" />
              </motion.button>

              <AnimatePresence>
                {showDropdown && (
                  <motion.div
                    initial={{ opacity: 0, y: 12, scale: 0.95 }}
                    animate={{ opacity: 1, y: 0, scale: 1 }}
                    exit={{ opacity: 0, y: 12, scale: 0.95 }}
                    transition={{ duration: 0.2, ease: 'easeOut' }}
                    className="absolute right-0 mt-2 w-64 overflow-hidden rounded-2xl border border-white/15 bg-gradient-to-b from-slate-900/95 to-slate-950/95 shadow-[0_24px_80px_rgba(2,6,23,0.7)] backdrop-blur-3xl z-50"
                  >
                    {/* Top border glow */}
                    <div className="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sky-500/20 to-transparent" />
                    
                    <div className="border-b border-white/10 px-4 py-3">
                      <p className="text-sm font-semibold text-slate-100">
                        {currentUser?.displayName || currentUser?.email || 'User'}
                      </p>
                      <p className="text-xs text-slate-500 mt-0.5">{currentUser?.email}</p>
                    </div>
                    <div className="py-1">
                      <Link
                        to="/profile"
                        className="block px-4 py-2.5 text-sm text-slate-200 transition duration-200 hover:bg-sky-500/15 hover:text-sky-100"
                        onClick={() => setShowDropdown(false)}
                      >
                        <User className="mr-3 inline h-4 w-4" />
                        Profile
                      </Link>
                      <button
                        onClick={handleLogout}
                        className="w-full px-4 py-2.5 text-left text-sm text-rose-300 transition duration-200 hover:bg-rose-500/20 hover:text-rose-200"
                      >
                        <LogOut className="mr-3 inline h-4 w-4" />
                        Logout
                      </button>
                    </div>
                  </motion.div>
                )}
              </AnimatePresence>
            </div>
          </div>
        </div>
        <div className="pb-4 md:hidden">
          <div className="group relative">
            <Search className="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500 transition-colors duration-300 group-focus-within:text-sky-400" />
            <input
              type="text"
              placeholder="Search listings..."
              value={searchValue}
              onChange={(event) => setSearchValue(event.target.value)}
              className="w-full rounded-2xl border border-white/15 bg-slate-900/60 backdrop-blur-sm py-3 pl-11 pr-4 text-sm text-slate-100 outline-none transition duration-300 placeholder:text-slate-600 focus:border-sky-400/50 focus:bg-slate-900/80 focus:ring-2 focus:ring-sky-500/25 hover:border-white/20"
            />
            {/* Inner shadow effect */}
            <div className="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-b from-white/5 to-transparent opacity-0 transition-opacity duration-300 group-focus-within:opacity-100" />
          </div>
        </div>
      </div>
    </nav>
  );
};

export default Navbar;
